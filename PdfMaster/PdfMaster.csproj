<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Dialecta PDF - Kişisel PDF İşlem Paketi</ApplicationTitle>
    <AssemblyName>DialectaPDF</AssemblyName>
    <RootNamespace>PdfMaster</RootNamespace>
    <Product>Dialecta PDF</Product>
    <Title>Dialecta PDF</Title>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>

    <!-- GC Optimizations for RAM limit (8GB) and Aggressive Cleanup -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <HeapHardLimit>8589934592</HeapHardLimit>
  </PropertyGroup>

  <ItemGroup>
    <None Update="tessdata\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Ghostscript.NET" Version="1.3.5" />
    <PackageReference Include="itext7" Version="9.7.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="Ronz.GSDLL" Version="17.9.26.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.jpg" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\Ghostscript\gsdll64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
