<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PDF Ayır"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Belgenizi sayfa aralıklarına göre bölün veya tek tek ayırın."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="Ayrılacak PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedFileName}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            <TextBlock Text="{Binding PageCount, StringFormat='{}{0} sayfa'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding PreviewImage}" Stretch="Uniform" /></Border>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Önceki" Command="{Binding PrevPreviewCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Margin="8,0">
                                <Run Text="{Binding PreviewPageIndex}" /><Run Text=" / " /><Run Text="{Binding PageCount}" />
                            </TextBlock>
                            <Button Content="Sonraki" Command="{Binding NextPreviewCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="AYIRMA YÖNTEMİ"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <RadioButton GroupName="SplitModeGroup" Content="Tüm sayfaları tek tek ayır"
                                 IsChecked="{Binding IsExtractAllSelected}" Margin="0,0,0,8" />
                    <RadioButton GroupName="SplitModeGroup" Content="Sayfa aralığına göre böl"
                                 IsChecked="{Binding IsPageRangesSelected}" Margin="0,0,0,4" />
                    <TextBlock Text="Örn: 1-3, 5, 8-10"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,4" />
                    <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,12" Height="36" />

                    <RadioButton GroupName="SplitModeGroup" Content="Her N sayfada bir böl"
                                 IsChecked="{Binding IsEveryNPagesSelected}" Margin="0,0,0,4" />
                    <DockPanel Margin="20,0,0,20">
                        <TextBlock Text="N:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding EveryNPages, UpdateSourceTrigger=PropertyChanged}"
                                 Width="56" HorizontalAlignment="Right" Height="36" />
                    </DockPanel>

                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,16" />
                    <Button Content="Dosyayı Kapat" Command="{Binding CloseFileCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Ayır"          Command="{Binding SplitCommand}"     Style="{StaticResource ModernBtnPrimary}"   HorizontalAlignment="Stretch" Height="40" />

                    <ProgressBar Height="3" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Margin="0,12,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <Button Content="Çıktı Klasörü" Command="{Binding OpenOutputFolderCommand}"
                        Style="{StaticResource ModernBtnSecondary}" DockPanel.Dock="Right" />
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Ayırmak için bir PDF açın.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
