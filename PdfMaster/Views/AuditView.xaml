<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Denetim Günlüğü"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Tüm işlemler SHA-256 özetleriyle yerel kütükte kayıt altındadır."
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Content="Yedekle (.ZIP)" Command="{Binding CreateBackupCommand}"  Style="{StaticResource ModernBtnPrimary}"   Margin="0,0,6,0" />
                <Button Content="Yenile"          Command="{Binding RefreshEventsCommand}" Style="{StaticResource ModernBtnSecondary}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Filtrele:"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </DockPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Events}"
                              SelectedItem="{Binding SelectedEvent}"
                              Background="{StaticResource BgInputBrush}"
                              BorderBrush="#0DFFFFFF"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontFamily="Inter, Segoe UI Variable, Segoe UI"
                              FontSize="12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarih"     Width="130" DisplayMemberBinding="{Binding TimestampLocal, StringFormat='dd.MM.yyyy HH:mm'}" />
                                <GridViewColumn Header="İşlem"     Width="90"  DisplayMemberBinding="{Binding Action}" />
                                <GridViewColumn Header="Açıklama"  Width="200" DisplayMemberBinding="{Binding ActionDescription}" />
                                <GridViewColumn Header="SHA-256"   Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OutputFileHash}"
                                                       FontFamily="JetBrains Mono, Consolas, Courier New"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="BELGE DOĞRULAMA"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Bir PDF dosyasının hash kaydını doğrulayın."
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="PDF Seç ve Doğrula"
                                Command="{Binding SelectVerifyFileCommand}"
                                Style="{StaticResource ModernBtnSecondary}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                        <Border Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,0,0,24">
                            <TextBlock Text="{Binding VerifyResultText}"
                                       FontFamily="JetBrains Mono, Consolas, Courier New"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0"
                                Padding="0,16,0,0" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DEPOLAMA"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Temizleme (gün):"
                                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                             Width="52" HorizontalAlignment="Right" Height="36" />
                                </DockPanel>
                                <Button Content="Eski Çıktıları Temizle"  Command="{Binding CleanupOldFilesCommand}"  Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                <Button Content="Depolama Klasörü"         Command="{Binding OpenStorageFolderCommand}" Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                <Button Content="Çıktılar Klasörü"         Command="{Binding OpenOutputsFolderCommand}" Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="0,14,0,0"
                BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='Denetim günlüğü aktif.'}"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
