<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.RedactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Hassas Veri Karartma"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Belirli kelimeleri veya verileri kalıcı olarak karartın."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="Karartılacak PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedFileName}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <Button Content="Değiştir" Command="{Binding SelectFileCommand}"
                                    Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding PreviewImage}" Stretch="Uniform" /></Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="KARARTILACAK KELİMELER"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Ekle" Command="{Binding AddKeywordCommand}"
                                Style="{StaticResource ModernBtnPrimary}"
                                DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,5" />
                        <TextBox Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Keywords}" SelectedItem="{Binding SelectedKeyword}"
                             Height="100" Background="{StaticResource BgInputBrush}"
                             BorderBrush="#0DFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                             FontFamily="Inter, Segoe UI Variable, Segoe UI" Margin="0,0,0,6" />
                    <Button Content="Seçili Kelimeyi Kaldır" Command="{Binding RemoveKeywordCommand}"
                            Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,16" HorizontalAlignment="Stretch" />

                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,14" />
                    <CheckBox Content="Büyük/küçük harf duyarlı" IsChecked="{Binding CaseSensitive}"  Margin="0,0,0,4" />
                    <CheckBox Content="Tam kelime eşleştir"       IsChecked="{Binding MatchWholeWord}" Margin="0,0,0,4" />
                    <CheckBox Content="Üzerine [GİZLENDİ] yaz"   IsChecked="{Binding OverlayText}"    Margin="0,0,0,20" />

                    <Button Content="Dosyayı Kapat" Command="{Binding CloseFileCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Karart"         Command="{Binding RedactCommand}"    Style="{StaticResource ModernBtnDanger}"   HorizontalAlignment="Stretch" Height="40" />

                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosyayı Aç"     Command="{Binding OpenOutputFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Karartma için bir PDF açın.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
