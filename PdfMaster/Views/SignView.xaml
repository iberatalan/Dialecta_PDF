<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.SignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="İmza ve Kriptografik Mühür"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Belgenize SHA-256 doğrulama mührü ve görsel kaşe/imza yerleştirin."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
            <TextBlock Text="Not: 5070 sayılı Kanun kapsamındaki NES yerine geçmez; yerel arşiv bütünlüğü amaçlıdır."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" FontStyle="Italic" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="Mühürlenecek PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedFileName}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <Button Content="Değiştir" Command="{Binding SelectFileCommand}"
                                    Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="8" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="{Binding PreviewPageWidth}" Height="{Binding PreviewPageHeight}" Background="White">
                                    <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                                    <Canvas Width="{Binding PreviewPageWidth}" Height="{Binding PreviewPageHeight}">
                                        <Border Canvas.Left="{Binding PosX}" Canvas.Top="{Binding PosY}"
                                                Width="260" Height="85"
                                                Background="#F5F8FF" BorderBrush="#2980B9"
                                                BorderThickness="1.5" CornerRadius="6">
                                            <Grid>
                                                <Border HorizontalAlignment="Left" Width="5"
                                                        Background="#2980B9" CornerRadius="2" Margin="0" />
                                                <StackPanel Margin="12,12,8,12">
                                                    <TextBlock Text="YEREL GÜVENLİ MÜHÜR &amp; DİJİTAL İMZA"
                                                               FontSize="8" FontWeight="Bold"
                                                               Foreground="#2980B9" FontFamily="Arial" />
                                                    <TextBlock Text="{Binding SignerName, StringFormat='İmzalayan: {0}'}"
                                                               FontSize="7.5" Foreground="#1E293B" FontFamily="Arial"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Reason, StringFormat='Amaç: {0}'}"
                                                               FontSize="7.5" Foreground="#64748B" FontFamily="Arial"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140" HorizontalAlignment="Left" />
                                                    <TextBlock Text="SHA-256: [Uygulanırken Hesaplanacak]"
                                                               FontSize="6.5" Foreground="#64748B"
                                                               FontFamily="Courier New" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <Image HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Width="80" Height="40" Margin="0,0,8,0"
                                                       Stretch="Uniform" Source="{Binding SignatureImagePath}" />
                                            </Grid>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MÜHÜR BİLGİLERİ"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="AD SOYAD" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SignerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="AMAÇ" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="KONUM" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,14" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="X konumu:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PosX, StringFormat='{}{0:F0}'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="{Binding MaxPosX}" Value="{Binding PosX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Y konumu:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PosY, StringFormat='{}{0:F0}'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="{Binding MaxPosY}" Value="{Binding PosY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <Button Content="İmza Görseli Ekle"  Command="{Binding SelectSignatureImageCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                        <Button Content="Dosyayı Kapat"       Command="{Binding CloseFileCommand}"            Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,16" HorizontalAlignment="Stretch" />
                        <Button Content="Mühürle ve Kaydet"   Command="{Binding SignAndSealCommand}"           Style="{StaticResource ModernBtnPrimary}"   HorizontalAlignment="Stretch" Height="40" />

                        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosyayı Aç"     Command="{Binding OpenOutputFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Mühürlemek için bir PDF seçin.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
