<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.OcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Yerel OCR"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Taranmış belgelerdeki metinleri yerel Tesseract motoruyla tanıyın."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoFile, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="OCR yapılacak PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedFileName}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <Button Content="Değiştir" Command="{Binding SelectFileCommand}"
                                    Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="{Binding PreviewImage}" Stretch="Uniform" /></Border>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Tanınan Metin"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="Kopyala" Command="{Binding CopyTextCommand}"
                                    Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBox Grid.Row="1" Text="{Binding ExtractedText}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                 FontFamily="JetBrains Mono, Consolas, Courier New"
                                 FontSize="12" Background="{StaticResource BgInputBrush}" Height="Auto" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="OCR AYARLARI"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="DOSYA"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding SelectedFileName}"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <Button Content="Dosya Değiştir" Command="{Binding SelectFileCommand}"
                            Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,20" HorizontalAlignment="Stretch" />

                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <TextBlock Text="DİL"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag" Margin="0,0,0,24">
                        <ComboBoxItem Content="Türkçe + İngilizce" Tag="tur+eng" IsSelected="True" />
                        <ComboBoxItem Content="Yalnızca Türkçe"    Tag="tur" />
                        <ComboBoxItem Content="Yalnızca İngilizce" Tag="eng" />
                    </ComboBox>

                    <Button Content="Dosyayı Kapat" Command="{Binding CloseFileCommand}"  Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Metinleri Tara" Command="{Binding StartOcrCommand}"  Style="{StaticResource ModernBtnPrimary}"   HorizontalAlignment="Stretch" Height="40" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="4" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}%{0} tamamlandı'}"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <Button Content="İptal Et" Command="{Binding CancelOcrCommand}"
                                Style="{StaticResource ModernBtnDanger}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Metin Dosyası"   Command="{Binding OpenTextFileCommand}"    Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster"  Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='OCR için bir PDF seçin.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
