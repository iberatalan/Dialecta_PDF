<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.OrganizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Sayfaları Düzenle ve Döndür"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Sayfaları sıralayın, döndürün veya silin."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="Düzenlenecek PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="150" ItemHeight="210" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInputBrush}"
                                            BorderBrush="#0DFFFFFF" BorderThickness="1"
                                            CornerRadius="8" Margin="4" Padding="6"
                                            Width="140" Height="200">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}"
                                                    CornerRadius="6" Margin="0,0,0,4" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform">
                                                    <Image.LayoutTransform>
                                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </Border>
                                            <Border Grid.Row="0" Background="#CC131313" CornerRadius="6"
                                                    Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Silindi"
                                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding PageNumber, StringFormat='{}Sayfa {0}'}"
                                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                                       FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="İŞLEMLER"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <Button Content="Dosya Seç"     Command="{Binding SelectFileCommand}"  Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Dosyayı Kapat" Command="{Binding CloseFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />

                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,8,0,10" />
                    <TextBlock Text="DÖNDÜR" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                    <Button Content="Sola Döndür"   Command="{Binding RotateLeftCommand}"  Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Sağa Döndür"   Command="{Binding RotateRightCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Tümünü Döndür" Command="{Binding RotateAllCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />

                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,8,0,10" />
                    <TextBlock Text="SIRALAMA" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                    <Button Content="Sola Taşı"  Command="{Binding MovePageLeftCommand}"  Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Sağa Taşı"  Command="{Binding MovePageRightCommand}" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,16" HorizontalAlignment="Stretch" />

                    <Button Content="Sil / Geri Al" Command="{Binding ToggleDeletePageCommand}" Style="{StaticResource ModernBtnDanger}"  Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                    <Button Content="Kaydet"         Command="{Binding SaveChangesCommand}"      Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Stretch" Height="40" />

                    <ProgressBar Height="3" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Margin="0,12,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosyayı Aç"     Command="{Binding OpenOutputFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Düzenlemek için bir PDF açın.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
