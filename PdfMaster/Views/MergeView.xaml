<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="PDF Birleştir"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Birden fazla PDF dosyasını tek bir belgede birleştirin."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="PDF dosyalarını buraya sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç"
                                        Command="{Binding AddFilesCommand}"
                                        Style="{StaticResource ModernBtnPrimary}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Files.Count, StringFormat='{}Dosyalar ({0})'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox Width="130" Margin="0,0,6,0" SelectedIndex="{Binding SelectedSortIndex}">
                                    <ComboBoxItem Content="Sırala..." />
                                    <ComboBoxItem Content="İsim (A-Z)" />
                                    <ComboBoxItem Content="İsim (Z-A)" />
                                    <ComboBoxItem Content="Tarih (Eski-Yeni)" />
                                    <ComboBoxItem Content="Tarih (Yeni-Eski)" />
                                </ComboBox>
                                <Button Content="Ekle"    Command="{Binding AddFilesCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                                <Button Content="Temizle" Command="{Binding ClearFilesCommand}" Style="{StaticResource ModernBtnSecondary}" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInputBrush}"
                                            BorderBrush="#0DFFFFFF" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding PageCount, StringFormat='{}{0} sayfa', Mode=OneWay}" />
                                                <Run Text=" Â· " />
                                                <Run Text="{Binding FileSizeFormatted, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="AYARLAR"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                    <Button Content="Yukarı Taşı"  Command="{Binding MoveUpCommand}"    Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Aşağı Taşı"   Command="{Binding MoveDownCommand}"  Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                    <Button Content="Kaldır"        Command="{Binding RemoveFileCommand}" Style="{StaticResource ModernBtnDanger}"   Margin="0,0,0,20" HorizontalAlignment="Stretch" />
                    <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,16" />

                    <TextBlock Text="ÇIKTI ADI"
                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding CustomOutputName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20" />

                    <Button Content="Birleştir"
                            Command="{Binding MergeCommand}"
                            Style="{StaticResource ModernBtnPrimary}"
                            HorizontalAlignment="Stretch" Height="40" />

                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="0,14,0,0"
                BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosyayı Aç"     Command="{Binding OpenOutputFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Birleştirmek için en az 2 PDF ekleyin.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
