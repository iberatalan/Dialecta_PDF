<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfMaster.Views.WatermarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Filigran Ekle"
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Sayfalarınıza metin veya görsel filigran yerleştirin."
                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                    Padding="16" Margin="0,0,16,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#1AFFFFFF" StrokeThickness="1.5"
                                       StrokeDashArray="6,4" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" Margin="48,32">
                                <TextBlock Text="Filigran eklenecek PDF dosyasını sürükleyin"
                                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                                        Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedFileName}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="350" />
                            <Button Content="Değiştir" Command="{Binding SelectFileCommand}"
                                    Style="{StaticResource ModernBtnSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}"
                                BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8"
                                Padding="8" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="{Binding PreviewPageWidth}" Height="{Binding PreviewPageHeight}" Background="White">
                                    <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                                    <TextBlock Text="{Binding WatermarkText}"
                                               Opacity="{Binding Opacity}"
                                               Foreground="{Binding ColorHex, FallbackValue=#FF0000}"
                                               FontSize="{Binding FontSize}"
                                               FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="{Binding RotationAngle}" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FİLİGRAN AYARLARI"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                        <TextBlock Text="METİN"
                                   FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Yazı boyutu:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FontSize, StringFormat='{}{0:F0} pt'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Minimum="14" Maximum="300" Value="{Binding FontSize}" Margin="0,0,0,12" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Saydamlık:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Minimum="0.05" Maximum="1.0" Value="{Binding Opacity}" Margin="0,0,0,12" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Döndürme:" FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RotationAngle, StringFormat='{}{0:F0}°'}"
                                       FontFamily="Inter, Segoe UI Variable, Segoe UI"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="360" Value="{Binding RotationAngle}" Margin="0,0,0,20" />

                        <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,16" />
                        <Button Content="Görsel Seç"       Command="{Binding SelectImageCommand}"     Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                        <Button Content="Dosyayı Kapat"    Command="{Binding CloseFileCommand}"       Style="{StaticResource ModernBtnSecondary}" Margin="0,0,0,16" HorizontalAlignment="Stretch" />
                        <Button Content="Filigranı Uygula" Command="{Binding ApplyWatermarkCommand}" Style="{StaticResource ModernBtnPrimary}"   HorizontalAlignment="Stretch" Height="40" />

                        <ProgressBar Height="3" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding ProgressValue}" Margin="0,12,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Dosyayı Aç"     Command="{Binding OpenOutputFileCommand}"   Style="{StaticResource ModernBtnSecondary}" Margin="0,0,6,0" />
                    <Button Content="Klasörde Göster" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ModernBtnSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Filigran eklemek için bir PDF açın.'}"
                           FontFamily="Inter, Segoe UI Variable, Segoe UI"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
